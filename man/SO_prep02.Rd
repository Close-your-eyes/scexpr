prepared <- SO_prep02(
  SO_unprocessed = list(sample_1 = sample_1),
  npcs = 20,
  RunUMAP_args = list(
    dims = list(seq_len(20), seq_len(10)),
    umap.method = "umap-learn",
    n.neighbors = 30L
